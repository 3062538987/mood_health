# ============================================
# Mood Health 环境变量模板
# 复制此文件为 .env 并填写实际值
# ============================================

# ---- 通用 ----
NODE_ENV=development

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mood_health

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI Provider ----
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ---- 内部服务认证 (Node ↔ FastAPI) ----
AI_SERVICE_INTERNAL_TOKEN=change-me-to-a-random-secret

# ---- FastAPI 服务 ----
MOOD_AI_SERVICE_PORT=8001

# ---- Node 服务 ----
PORT=3000
FASTAPI_BASE_URL=http://127.0.0.1:8001

# ---- 加密 ----
ENCRYPTION_KEY=change-me-to-a-32-byte-key

# ---- 日志 ----
LOG_LEVEL=INFO