    "db:migrate:status": "ts-node src/db/migrate.ts status",
    "db:seed:reference": "ts-node src/db/seed.ts reference",
    "db:seed:demo": "ts-node src/db/seed.ts demo",
    "db:seed:test": "ts-node src/db/seed.ts test",
    "db:seed:all": "ts-node src/db/seed.ts all",
    "test:sqlite-smoke": "ts-node src/scripts/sqliteSmokeTest.ts",
    "test:role-permissions": "ts-node src/scripts/test_role_permissions.ts",
    "doctor": "node -e \"require('fs').existsSync('dist/server.js') ? (console.log('dist/server.js found'), process.exit(0)) : (console.log('dist/server.js missing, run npm run build'), process.exit(1))\"",
    "test": "npm run test:stable",
    "test:stable": "jest tests/unit --runInBand",
    "test:integration": "jest tests/unit --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
