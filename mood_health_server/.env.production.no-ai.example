# Node runtime
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
FRONTEND_URL=https://your-domain.com

# Security
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_64_hex_chars

# MySQL (2C2G recommended)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mood_health
MYSQL_APP_USER=mood_app
MYSQL_APP_PASSWORD=replace-with-a-strong-app-password
MYSQL_MIGRATOR_USER=mood_migrator
MYSQL_MIGRATOR_PASSWORD=replace-with-a-strong-migrator-password
MYSQL_POOL_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_QUERY_TIMEOUT_MS=5000

# AI strategy (no local model)
AI_ENABLED=false
AI_SERVICE_BASE_URL=http://127.0.0.1:8001

# Optional cache
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# Login rate limit
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20

# Generic rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs
