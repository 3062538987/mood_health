# ============================================
# Node.js 环境
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# MySQL 数据库连接 （必填）
# ============================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mood_health
MYSQL_APP_USER=mood_app
MYSQL_APP_PASSWORD=<your-mysql-app-password>             # （必填）改成你MySQL里mood_app用户的密码
MYSQL_MIGRATOR_USER=mood_migrator
MYSQL_MIGRATOR_PASSWORD=<your-mysql-migrator-password>       # （必填）改成你MySQL里mood_migrator用户的密码
MYSQL_POOL_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_QUERY_TIMEOUT_MS=5000

# ============================================
# JWT 配置 （必填）
# ============================================
# 生成密钥命令：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<your-strong-random-jwt-secret>             # （必填）用上面命令生成
JWT_EXPIRES_IN=7d

# ============================================
# 加密密钥 （必填）
# ============================================
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<your-64-character-hex-encryption-key>           # （必填）用上面命令生成

# ============================================
# Demo 种子数据（可选）
# ============================================
ALLOW_DEMO_SEED=false                         # 需要初始化Demo账号时改为true
DEMO_PASSWORD=<your-demo-password>                  # 初始化前改成你想要的临时 demo 密码

# ============================================
# 前端 URL（CORS 白名单）
# ============================================
FRONTEND_URL=http://localhost:3001,http://localhost:5173

# ============================================
# AI 配置（可选，低配机器建议关闭）
# ============================================
AI_ENABLED=true
AI_SERVICE_BASE_URL=http://127.0.0.1:8000

# ============================================
# Redis 配置（可选，AI 服务用）
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_REQUIRED=false

# ============================================
# 限流配置
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs
