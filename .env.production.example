# Frontend production environment
VITE_API_BASE_URL=https://your-domain.com/api
VITE_BASE_URL=/
VITE_FEATURE_NON_CORE_MODULES_ENABLED=false

# Docker Compose dependencies (copy to .env and replace every secret)
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=mood_health
MYSQL_APP_USER=mood_app
MYSQL_APP_PASSWORD=replace-with-a-strong-app-password
MYSQL_PORT=3306

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379
