@echo off
cd /d "%~dp0"
powershell -ExecutionPolicy Bypass -Command "$ports=@(3000,3001,8001); foreach($p in $ports){ $conn=netstat -ano 2>$null|Select-String \":$p .*LISTENING\"; if($conn){ $procId=$conn -replace '.*\s+(\d+)$','$1'; if($procId){ Stop-Process -Id $procId -Force -ErrorAction SilentlyContinue; Write-Host \"Port $p killed (PID $procId)\" } } }; Start-Sleep 1; Start-Process cmd -ArgumentList '/k','cd /d \"%CD%\mood_health_ai_service\" && uvicorn app.main:app --host 127.0.0.1 --port 8001 --reload' -WindowStyle Normal; Start-Sleep 3; Start-Process cmd -ArgumentList '/k','cd /d \"%CD%\mood_health_server\" && npm run dev' -WindowStyle Normal; Start-Sleep 5; Start-Process cmd -ArgumentList '/k','cd /d \"%CD%\" && npm run dev' -WindowStyle Normal; Start-Sleep 8; Start-Process http://localhost:3001"
pause