# ===== Mood Health AI Service 环境变量示例 =====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。

# 服务端口（铁律：8001）
MOOD_AI_SERVICE_PORT=8001
NODE_ENV=development

# MySQL（与后端隔离，使用项目约定的 3316 端口）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3316
MYSQL_USER=root
MYSQL_PASSWORD=请替换为强口令
MYSQL_DATABASE=mood_health

# Redis（与后端隔离）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# DeepSeek（如使用火山方舟等兼容网关，改 BASE_URL 与 KEY 即可）
AI_API_KEY=请替换为真实 DeepSeek Key（泄露后立即轮换）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# RAG 检索
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_COLLECTION_NAME=mental_health_knowledge_bge_zh_v1
RAG_PERSIST_DIRECTORY=./data/chroma
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.60

# ===== 内部服务认证（必填，非空）=====
# 后端 mood_health_server 调用本服务时必须携带同一 token 的 HMAC 签名。
# 启动时空值将导致服务拒绝启动（fail-closed）。两端必须保持一致。
AI_SERVICE_INTERNAL_TOKEN=请替换为强随机值（如 openssl rand -hex 32）

# 日志级别
LOG_LEVEL=INFO

# 本地开发可临时跳过启动配置校验（仅限本机调试，禁止生产使用）
# AI_SERVICE_SKIP_CONFIG_VALIDATION=1
